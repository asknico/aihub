# ==================================================
# AIHub Local / Runtime（本机私有，整个目录不进版本库）
# ==================================================

/local/*
!/local/README.md

# 外部运行时目录优先放仓库外：C:/AIHubData（见 .env.example）
/runtime/*

# ==================================================
# Generated artifacts（生成物：脚本生成，禁止手工编辑）
# 依据：根 AGENTS.md §7.1
# ==================================================

# 纯派生视图：git ls-files / tree 命令随时可重现，入库只有 diff 噪音
/AIHUB_TREE.txt

# 根目录副本与 docs/AIHUB_STRUCTURE.md 重复且已各自漂移，
# 唯一入库的结构文档是 docs/AIHUB_STRUCTURE.md
/AIHUB_STRUCTURE.md

# 注意：registry/*.yaml 同为生成物，但属于分发产物（克隆即用），
# 仍然入库；纪律是只能由 scripts/sync.py 重新生成，不手工编辑。

# ==================================================
# Environment
# ==================================================

.env
.env.*
!.env.example

# ==================================================
# Secrets / Credentials
# ==================================================

# 按扩展名匹配：命中即视为凭据文件，无论在哪一层
*.secret
*.secrets
*.credential
*.credentials

# 裸名 credentials.* / secrets.* 必须锚定到仓库根。
# 不加斜杠会连 shared/rules/security/secrets.md 这类「讲密钥的规则文件」
# 一起排除 —— 它们文件名相同但性质完全相反，是仓库的正常内容。
/credentials.*
/secrets.*

*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519

# ==================================================
# MCP
# ==================================================

# mcp.json 是本机装配产物（含真实连接信息/密钥），只提交 example
/mcp/mcp.json
mcp.local.json
*.mcp.local.json

# ==================================================
# Local overrides（任何层级的 .local.* 都是本机覆盖，不入库）
# ==================================================

*.local.yaml
*.local.yml
*.local.json

# ==================================================
# Python（scripts/ 运行产物）
# ==================================================

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ==================================================
# Agent runtime 产物（会话/缓存/日志/临时文件，任何层级）
# ==================================================

**/.cache/
**/cache/
**/sessions/
**/session/
**/history/
**/logs/
**/tmp/
**/temp/
*.log

# ==================================================
# Agent 技能目录联接（install.py 生成的本机装配结果）
# ==================================================

/agents/*/skills

# ==================================================
# IDE / OS
# 注意：必须写 .vscode/* 而不是 .vscode/ ——
# git 规则是「父目录被排除后，其中的文件无法被重新包含」，
# 写 .vscode/ 会让下面的 !.vscode/settings.json.example 永远失效
# ==================================================

.idea/
.vscode/*
!.vscode/settings.json.example
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
