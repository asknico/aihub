# ==========================================================================
# CODEOWNERS —— 目录属主
# ==========================================================================
# 语法：<路径模式> <@用户 或 @组织/团队>
# 匹配规则：取「最后一条命中」的模式，所以具体规则要写在通配 * 之后。
#
# 生效前提：仓库 Settings → Branches 里给 master 开启分支保护，
# 并勾选 "Require review from Code Owners"。否则本文件不会拦住任何提交。
#
# ⚠️ 属主占位：仓库尚未配置远程，这里用本地 git 用户名 asknico 占位。
#    如果 GitHub 账号名不同，请全局替换，否则 CODEOWNERS 会被判为无效
#    （GitHub 会对无法解析的属主给出告警，且该行不生效）。
# ==========================================================================

# 默认属主：未命中下面任何规则的改动
*                           @asknico

# --------------------------------------------------------------------------
# 枢纽契约层 —— 改动会影响所有 Agent，最需要复核
# --------------------------------------------------------------------------
/AGENTS.md                  @asknico
/shared/rules/              @asknico
/shared/skills/             @asknico

# --------------------------------------------------------------------------
# 装配与登记 —— 改动会影响本机的目录联接与角色档解析
# --------------------------------------------------------------------------
/registry/                  @asknico
/profiles/                  @asknico
/scripts/                   @asknico

# --------------------------------------------------------------------------
# 仓库行为定义 —— 换行符、忽略规则、钩子、CI
# --------------------------------------------------------------------------
/.gitattributes             @asknico
/.gitignore                 @asknico
/.githooks/                 @asknico
/.github/                   @asknico

# --------------------------------------------------------------------------
# 密钥相关模板 —— 只能放键名与占位符，绝不放真实值
# --------------------------------------------------------------------------
/.env.example               @asknico
